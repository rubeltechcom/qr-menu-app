# Copy this file to .env.local for local development.
# Every variable here is validated at boot by src/lib/env.ts — the app
# will refuse to start if a required value is missing or malformed.

NODE_ENV=development

# --- App ---
# Public base URL of the marketing site.
APP_URL=http://localhost:3000
# Root domain used to resolve tenant subdomains, e.g. app.example.com,
# joespizza.example.com. Locally this can stay as localhost.
APP_DOMAIN=localhost

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://qrmenu:qrmenu_dev_password@localhost:5432/qrmenu_dev

# --- Redis (matches docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- Auth (Auth.js / NextAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-32+-char-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
# Subscription price ids, created in the Stripe dashboard. Without
# these the plan cards render but cannot be purchased.
STRIPE_PRICE_SMART_MONTHLY=
STRIPE_PRICE_SMART_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# --- bKash (Tokenized Checkout) ---
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Sandbox by default. Only set this to false when you intend to move
# real money — a missing variable must never point at live payments.
BKASH_SANDBOX=true

# --- Object storage (S3-compatible: R2, S3, MinIO) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Observability ---
SENTRY_DSN=
