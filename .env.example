# Copy this file to .env.local for local development.
# Every variable here is validated at boot by src/lib/env.ts — the app
# will refuse to start if a required value is missing or malformed.

NODE_ENV=development

# --- App ---
# Public base URL of the marketing site.
APP_URL=http://localhost:3000
# OPTIONAL — leave blank unless you genuinely run per-restaurant
# subdomains (joespizza.example.com).
#
# Blank is the recommended setup. Every restaurant is then served from
# one hostname as example.com/m/<slug>/t/<code>: one certificate, and
# nothing to configure in DNS when a restaurant signs up.
#
# Only set it if BOTH are true, or the app will hand out links that no
# server answers — and a printed QR code cannot be corrected afterwards:
#   1. DNS has a wildcard record (*.example.com) pointing at this app
#   2. the TLS certificate covers that wildcard. Note a two-level
#      wildcard (*.menu.example.com) is NOT covered by a normal
#      certificate and usually needs a paid add-on.
APP_DOMAIN=

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://qrmenu:qrmenu_dev_password@localhost:5432/qrmenu_dev

# --- Redis (matches docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- Auth (Auth.js / NextAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-32+-char-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
# Subscription price ids, created in the Stripe dashboard. Without
# these the plan cards render but cannot be purchased.
STRIPE_PRICE_SMART_MONTHLY=
STRIPE_PRICE_SMART_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# --- bKash (Tokenized Checkout) ---
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Sandbox by default. Only set this to false when you intend to move
# real money — a missing variable must never point at live payments.
BKASH_SANDBOX=true

# --- Uploads (dish photos) ---
#
# These three are COMMENTED OUT on purpose. Do not paste them into a
# deployment with empty values: an empty environment variable overrides
# the Dockerfile's own ENV, so `UPLOAD_DIR=` would silently discard the
# container's /data/uploads and fall back to a path inside the image —
# which is destroyed on every redeploy.
#
# Locally, uncomment only what you want to change.
#
# Where uploaded photos are written when S3 is not configured. The
# Docker image already sets this to /data/uploads; leave it alone there
# unless you mount the volume somewhere else.
#
# WHEREVER IT POINTS, IT MUST BE A MOUNTED VOLUME IN PRODUCTION. Anything
# inside the container image is destroyed on every redeploy, and because
# the database rows survive, the result is a menu full of broken images
# rather than an obvious failure. Check /admin/diagnostics after
# deploying — it confirms whether the directory is a real volume. Back
# that volume up alongside Postgres: a database-only restore loses every
# photo.
# UPLOAD_DIR=/data/uploads
#
# Largest accepted upload, in bytes. Default 8388608 (8MB). The browser
# downscales photos well below this before sending them.
# UPLOAD_MAX_BYTES=8388608
#
# Optional absolute prefix (a CDN) in front of locally-stored uploads.
# Omit it to serve them from this app, which is what a single server
# wants.
# UPLOAD_PUBLIC_BASE=https://cdn.example.com

# --- Object storage (S3-compatible: R2, S3, MinIO) ---
# Optional. Setting BUCKET + ACCESS_KEY_ID + SECRET_ACCESS_KEY switches
# uploads from local disk to object storage, with no code change; URLs
# already stored keep working. Worth doing only when you run more than
# one app container (a local volume cannot be shared) or want a CDN.
# ENDPOINT is left blank for real AWS, and set for R2 or MinIO.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Observability ---
SENTRY_DSN=
