# Normalise line endings so a Windows checkout cannot break a Linux build.
#
# Git on Windows converts LF to CRLF on checkout by default. For most
# files that is harmless, but a shell script with CRLF endings fails in
# Alpine with a confusing "bad interpreter" error, because the kernel
# reads the trailing \r as part of the interpreter path.

* text=auto

# Must stay LF: executed by /bin/sh inside the container.
*.sh text eol=lf
docker-entrypoint.sh text eol=lf
Dockerfile text eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.mp4 binary
*.mov binary
*.webm binary
*.woff binary
*.woff2 binary
*.wav binary
