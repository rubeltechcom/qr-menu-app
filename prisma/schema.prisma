// Prisma schema — Phase 0/1 (tenancy, auth), Phase 2 (menu management),
// Phase 3 (zones, tables, QR) and Phase 4 (ordering). Billing and growth
// models are added in their respective build phases per PROMPT.md §11.
// Every tenant-owned model below carries tenantId + timestamps, and soft
// delete where a record is user-managed, per PROMPT.md §3 and §4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform & identity
// ---------------------------------------------------------------------------

enum GlobalRole {
  SUPERADMIN
  USER
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  hashedPassword String?
  name          String?
  avatarUrl     String?
  globalRole    GlobalRole   @default(USER)
  memberships   Membership[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@map("users")
}

enum MembershipRole {
  OWNER
  MANAGER
  WAITER
  KITCHEN
  ACCOUNTANT
}

model Tenant {
  id                 String       @id @default(cuid())
  slug               String       @unique
  name               String
  // Plan and subscription state. Both are plain strings rather than
  // enums so a webhook carrying a status Stripe added yesterday is
  // recorded rather than rejected; PLANS + effectivePlan() in
  // src/modules/billing/plans.ts decide what each value entitles.
  plan               String       @default("FREE")
  subscriptionStatus String       @default("TRIALING")
  stripeCustomerId   String?      @unique
  stripeSubscriptionId String?    @unique
  connectAccountId   String?      @unique
  // Whether the Connect account has finished onboarding and may take
  // payments — Stripe's charges_enabled, mirrored here so the checkout
  // path does not have to call Stripe to find out.
  connectChargesEnabled Boolean   @default(false)
  trialEndsAt        DateTime?
  currentPeriodEndsAt DateTime?
  // Set when a payment fails; the 7-day grace period (PROMPT.md §9) is
  // measured from here, and cleared as soon as a payment succeeds.
  pastDueSince       DateTime?
  // How this restaurant takes money from diners.
  paymentMode        String       @default("COUNTER") // COUNTER | OPTIONAL | REQUIRED
  payments           Payment[]
  webhookEvents      WebhookEvent[]
  /// The restaurant's own logo, shown in its storefront header in place
  /// of the generic mark. Null means "use the name alone".
  logoUrl            String?
  /// Locales this restaurant offers its guests, the first being the
  /// default. `defaultLocale` remains the fallback for a guest whose
  /// choice is not on this list.
  locales            String[]     @default(["en"])
  defaultLocale      String       @default("en")
  currency           String       @default("USD")
  featureFlags       Json         @default("{}")
  memberships        Membership[]
  domains            Domain[]
  locations          Location[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  @@map("tenants")
}

model Membership {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       MembershipRole
  locationId String? // null = access to all locations under the tenant
  staffPin   StaffPin?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("memberships")
}

model StaffPin {
  id           String     @id @default(cuid())
  membershipId String     @unique
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  hashedPin    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("staff_pins")
}

enum DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
}

model Domain {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostname   String       @unique
  status     DomainStatus @default(PENDING)
  verificationToken String @default(cuid())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([tenantId])
  @@map("domains")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorUserId String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Storefront content (skeleton — extended in Phase 2)
// ---------------------------------------------------------------------------

/// Platform-wide configuration the operator edits from /admin, rather
/// than by changing environment variables and redeploying.
///
/// One row per setting key. Values are strings because that is what an
/// environment variable is — the settings module parses and validates
/// them, so this table stays a dumb store and cannot drift from the
/// schema that reads it.
///
/// A secret value (`isSecret`) is encrypted at rest, so a database dump
/// or a stolen backup does not hand over live payment credentials.
model PlatformSetting {
  key       String   @id
  value     String
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  /// Who last changed it — an audit trail for the one account that can
  /// reconfigure the whole platform.
  updatedBy String?

  @@map("platform_settings")
}

model Location {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  timezone  String    @default("UTC")
  phone     String?
  currency  String    @default("USD")
  menus     Menu[]
  zones     Zone[]
  tables    Table[]
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Menu management (Phase 2)
// ---------------------------------------------------------------------------

model Menu {
  id         String     @id @default(cuid())
  tenantId   String
  locationId String
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  // Optional availability window, e.g. Breakfast 07:00-11:00. Both null
  // means "always available". Stored as "HH:mm" 24h strings — timezone
  // comes from the owning Location.
  availableFrom String?
  availableTo   String?
  isActive   Boolean    @default(true)
  sortOrder  Int        @default(0)
  categories Category[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  @@index([tenantId])
  @@index([locationId])
  @@map("menus")
}

model Category {
  id          String     @id @default(cuid())
  tenantId    String
  menuId      String
  menu        Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  // A single emoji the owner picks for the storefront's category strip.
  // Null means "not chosen": the storefront then guesses one from the
  // category's name, so menus created before this existed still render
  // an icon rather than a blank tile.
  icon        String?
  sortOrder   Int        @default(0)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([tenantId])
  @@index([menuId])
  @@map("categories")
}

model MenuItem {
  id             String          @id @default(cuid())
  tenantId       String
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  // Money stored as an integer in the currency's minor unit (cents),
  // per PROMPT.md §4's money rule — never a float.
  basePriceCents Int
  // Up to five, shown as a gallery on the storefront. The first is the
  // one the menu grid uses.
  images         String[]        @default([])
  /// One short clip, shown before the photos. Kept separate from
  /// `images` rather than mixed into it so every consumer knows which
  /// one needs a <video> element without sniffing file extensions.
  videoUrl       String?
  allergens      String[]        @default([])
  dietaryTags    String[]        @default([])
  calories       Int?
  prepTimeMinutes Int?
  spiceLevel     Int?            @default(0)
  isAvailable    Boolean         @default(true)
  // null = untracked/unlimited stock; a number is decremented as orders
  // come in once ordering (Phase 3+) is wired up.
  stockCount     Int?
  sortOrder      Int             @default(0)
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@index([tenantId])
  @@index([categoryId])
  @@map("menu_items")
}

model ModifierGroup {
  id          String     @id @default(cuid())
  tenantId    String
  menuItemId  String
  menuItem    MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name        String
  // e.g. "Choose size" -> required, single-select (min=1, max=1).
  // "Add toppings" -> optional, multi-select (min=0, max=4).
  minSelect   Int        @default(0)
  maxSelect   Int        @default(1)
  sortOrder   Int        @default(0)
  modifiers   Modifier[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId])
  @@index([menuItemId])
  @@map("modifier_groups")
}

model Modifier {
  id              String        @id @default(cuid())
  tenantId        String
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name            String
  priceDeltaCents Int           @default(0)
  isAvailable     Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
  @@index([modifierGroupId])
  @@map("modifiers")
}

model Translation {
  id                 String   @id @default(cuid())
  tenantId           String
  entityType         String
  entityId           String
  field              String
  locale             String
  value              String
  isMachineTranslated Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, entityType, entityId, field, locale])
  @@index([tenantId, entityType, entityId])
  @@map("translations")
}

// ---------------------------------------------------------------------------
// Storefront — zones, tables and QR codes (Phase 3)
// ---------------------------------------------------------------------------

model Zone {
  id         String    @id @default(cuid())
  tenantId   String
  locationId String
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int       @default(0)
  tables     Table[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([tenantId])
  @@index([locationId])
  @@map("zones")
}

model Table {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  zoneId     String?
  zone       Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  orders     Order[]

  // Human-facing label the staff use ("12", "Patio 3"). Unique per
  // location so two tables cannot both be called "12".
  label String

  // The code that appears in the QR URL (/t/<publicCode>). Short enough
  // to fit a small printed code, random enough that a diner cannot guess
  // a neighbouring table and order to it. Globally unique because the
  // storefront resolves a table from this code ALONE — there is no tenant
  // in the URL to scope the lookup by.
  publicCode String @unique

  seats     Int?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([locationId, label])
  @@index([tenantId])
  @@index([locationId])
  @@map("tables")
}

// ---------------------------------------------------------------------------
// Ordering (Phase 4)
// ---------------------------------------------------------------------------

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING // placed by the diner, not yet seen by staff
  ACCEPTED // staff acknowledged it
  READY // ready to serve / collect
  COMPLETED // handed over
  REJECTED // staff declined it, with a reason
}

model Order {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // Human-facing number, sequential per location per day (see
  // order-number.ts). Staff call orders out by this, so it restarts each
  // service rather than growing forever.
  orderNumber Int
  // The day `orderNumber` counts within, in the location's timezone,
  // stored as a plain YYYY-MM-DD string. A DateTime would invite
  // timezone drift on exactly the boundary this exists to pin down.
  businessDate String

  type   OrderType
  status OrderStatus @default(PENDING)

  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  // Contact details, required for takeaway/delivery and optional for
  // dine-in. Kept on the order rather than joined to a Customer record:
  // diners are anonymous, and a phone number typed today must not change
  // retroactively if the same person later edits a saved profile.
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  deliveryAddress String?

  note String?

  // Null means ASAP. Set when the diner picks a later time.
  scheduledFor DateTime?

  // Money in minor units (PROMPT.md §4). Totals are stored rather than
  // recomputed on read so a historical order never changes because a tax
  // rate or delivery fee was edited afterwards.
  subtotalCents    Int
  deliveryFeeCents Int @default(0)
  totalCents       Int
  // Snapshotted from the location at order time, like the item prices
  // above: if a restaurant later switches currency, last month's
  // receipts must still read in the currency they were actually paid in.
  currency         String @default("USD")

  rejectionReason String?

  // Handed to the diner so they can follow their order without an
  // account. Unguessable for the same reason a table's publicCode is.
  trackToken String @unique

  // Denormalised from the order's payments so the board can colour a
  // card "paid" without joining, and so an order with no payment row at
  // all (counter service) still has an answer.
  paymentStatus PaymentStatus @default(PENDING)

  items    OrderItem[]
  events   OrderEvent[]
  payments Payment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  acceptedAt  DateTime?
  readyAt     DateTime?
  completedAt DateTime?
  rejectedAt  DateTime?

  @@unique([locationId, businessDate, orderNumber])
  @@index([tenantId])
  @@index([tenantId, locationId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  tenantId String
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Nullable and SetNull on delete: an order must survive the dish being
  // removed from the menu. Everything needed to print the ticket is
  // snapshotted below, so the relation is only for analytics.
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  // Snapshot at time of order — never a live join. Menu prices change;
  // last week's receipt must not.
  nameSnapshot      String
  unitPriceCents    Int
  quantity          Int
  lineTotalCents    Int
  // Chosen modifiers, snapshotted as [{groupName, name, priceDeltaCents}].
  modifiersSnapshot Json?
  note              String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id       String @id @default(cuid())
  tenantId String
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status OrderStatus
  // Null when the diner caused it (placing the order); set to the staff
  // user id for staff transitions.
  actorUserId String?
  note        String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([orderId, createdAt])
  @@map("order_events")
}

// Allocates orderNumber per location per day. A dedicated row taken with
// SELECT ... FOR UPDATE is what keeps two simultaneous orders from
// getting the same number — see order-number.ts.
model OrderCounter {
  id           String @id @default(cuid())
  tenantId     String
  locationId   String
  businessDate String
  nextNumber   Int    @default(1)

  @@unique([locationId, businessDate])
  @@index([tenantId])
  @@map("order_counters")
}

// ---------------------------------------------------------------------------
// Payments (Phase 5)
// ---------------------------------------------------------------------------

enum PaymentProvider {
  STRIPE
  BKASH
  // Cash or card at the counter — recorded so an order's payment state
  // is answerable from one place regardless of how the money arrived.
  COUNTER
}

enum PaymentStatus {
  PENDING // created, awaiting the diner
  AUTHORIZED // provider holds the funds, not yet captured
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)

  // Money in minor units, per PROMPT.md §4.
  amountCents   Int
  currency      String
  // What the platform takes from this order (0 on paid plans).
  platformFeeCents Int @default(0)
  refundedCents Int @default(0)

  /**
   * The provider's own id for this payment — a Stripe PaymentIntent id,
   * or a bKash paymentID. Unique so a webhook replay cannot create a
   * second row for the same payment.
   */
  providerRef String? @unique
  /** Provider-side id the diner is sent to, e.g. a bKash bkashURL token. */
  providerSessionRef String?
  /** Last error the provider reported, for support to read. Never card data. */
  failureReason String?

  refunds PaymentRefund[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  failedAt    DateTime?

  @@index([tenantId])
  @@index([orderId])
  @@map("payments")
}

model PaymentRefund {
  id        String  @id @default(cuid())
  tenantId  String
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amountCents Int
  reason      String?
  /** Provider's refund id; unique so a replayed webhook is a no-op. */
  providerRef String? @unique
  actorUserId String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([paymentId])
  @@map("payment_refunds")
}

/**
 * Webhook de-duplication (PROMPT.md §5.5: "processed idempotently via an
 * event-ID dedupe table").
 *
 * Providers retry aggressively and will happily deliver the same event
 * twice. Recording the id before acting on it is what stops a retry
 * refunding an order a second time.
 */
model WebhookEvent {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  provider PaymentProvider
  /** The provider's event id — the dedupe key. */
  eventId   String
  eventType String
  payload   Json

  processedAt DateTime?
  error       String?

  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([tenantId])
  @@map("webhook_events")
}
